{
  "name": "flora-home-online-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:domain": "tsc -p scripts/tsconfig.test.json && node .test-build/scripts/test-domain.js",
    "test:validation": "tsc -p scripts/tsconfig.validation.json && node .test-build/scripts/test-validation.js",
    "test:rate-limit": "tsc -p scripts/tsconfig.rate-limit.json && node .test-build/scripts/test-rate-limit.js",
    "test:request-body": "tsc -p scripts/tsconfig.request-body.json && node .test-build/scripts/test-request-body.js",
    "test:catalog": "tsc -p scripts/tsconfig.catalog.json && node .test-build/scripts/test-catalog.js",
    "test:apps-script": "node scripts/test-apps-script.mjs",
    "test": "npm run test:domain && npm run test:validation && npm run test:rate-limit && npm run test:request-body && npm run test:catalog && npm run test:apps-script"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5"
  }
}
