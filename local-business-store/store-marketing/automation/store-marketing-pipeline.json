      "id": "bb6e35b5-6336-4a68-89b3-b2d67a6525eb",
      "name": "Has Photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "AQ.Ab8RN6Il7OJcCwHo_dKzESZ5bUi--sP5JgvixdDYNBuoQ-bSBQ"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [\n    {\n      parts: [\n        {\n          text: \"أنت خبير تسويق محلي ومهندس ديكور داخلي راقي لمحل تحف في الوراق. المطلوب إخراج نتيجتين بناء على وصف وصورة القطعة:\\n1. بوست بالعامية المصرية الهادية والبسيطة بدون مبالغة، يوضح مكانها الصح (نيش، رف مكتبة، أو بوفيه محمي) مع دعوة لزيارة المحل والتواصل واتساب على 01070810979.\\n2. برومت باللغة الإنجليزية لتوليد صورة لايف ستايل واقعية ومبهرة للقطعة محطوطة في مكانها الآمن المناسب (مثلا على رف خشب فاخر مع كتب وإضاءة هادية).\\n\\nأجب بصيغة JSON فقط بهذا الشكل:\\n{\\n  \\\"post\\\": \\\"نص البوست بالعامية...\\\",\\n  \\\"image_prompt\\\": \\\"A luxury interior photography of the product safely displayed on an elegant display shelf in a modern living room, warm accent lighting, 8k...\\\"\\n}\\n\\nتفاصيل القطعة من صاحب المحل: \" + ($json.message?.caption || \"تحفة ديكور راقية\")\n        }\n      ]\n    }\n  ],\n  generationConfig: {\n    responseMimeType: \"application/json\"\n  }\n}) }}",
        "options": {}
      },
      "id": "6ae2aadd-4ca9-478e-b9bb-c92f28b29fcd",
      "name": "Generate Copy & Staging Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiRaw = $input.item.json.candidates[0].content.parts[0].text;\nconst parsed = JSON.parse(aiRaw);\nconst chatId = $('Telegram Mobile Trigger').item.json.message.chat.id;\nconst encodedPrompt = encodeURIComponent(parsed.image_prompt || 'luxury modern home decor on display shelf');\nconst photoUrl = `https://image.pollinations.ai/prompt/${encodedPrompt}?width=1024&height=1024&nologo=true&model=flux`;\n\nreturn {\n  chatId,\n  post: parsed.post,\n  photoUrl\n};"
      },
      "id": "c1f8a85e-990a-4299-8ab1-19b84a9e3d04",
      "name": "Prepare Photo & Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        -80
      ]
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "={{ $json.chatId }}",
        "file": "={{ $json.photoUrl }}",
        "additionalFields": {
          "caption": "={{ $json.post }}"
        }
      },
      "id": "a1346b18-a362-48eb-850a-f91e2d9ae4f5",
      "name": "Send Lifestyle Photo with Copy",
