# ==============================================================================
# Growth Workspace Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and insert your real API secrets:
# cp .env.example .env

# Notion Integration Secret (https://www.notion.so/profile/integrations)
NOTION_TOKEN=secret_your_token_here

# (Optional) Parent Page ID or Database ID for newly created records
NOTION_PAGE_ID=

# OpenRouter API Key for multi-agent routing
OPENROUTER_API_KEY=
